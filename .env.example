# StudyForge environment configuration
#
# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Google AI Studio API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Gemini model identifier
GEMINI_MODEL=gemini-3.6-flash

# --- Retrieval layer (SF-10) ---
# Embedding model. Retired on a different schedule from the generation model,
# so it is configured separately. See AID-1 in docs/ai-decisions.md.
EMBEDDING_MODEL=gemini-embedding-001

# Chunking, in characters. A chunk never spans a page boundary, so short pages
# produce shorter chunks than CHUNK_SIZE.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

